# Parameters for tools/ops/run.sh jobs (sourced by bash: KEY=VALUE, no spaces around "=", quote values with spaces).
# Everything is optional; the commented values are the defaults. Machine-local paths and keys belong in the
# git-ignored .cache/ops.env on the runner, never here.

# PROJECT=                      # default: gcloud config get-value project
# REGION=us-west1
# SERVICE=hello-watch
# TAG=next                      # traffic tag of the staging revision (deploy-staging / bench / promote)

# PACKS_PREFIX=                 # packs path inside the service's bucket (e.g. demo-packs-next): deploy-staging sets
#                               # WATCH_PACKS_GCS to it on the new revision, bench grades against it; default: what
#                               # the PRODUCTION revision serves. Never put bucket or project names here.

# deploy-staging builds the revision's WHOLE environment from these parameters (deploy/web/env.sh, --set-env-vars):
# nothing carries over from the previous revision, so a line removed here is gone on the next deploy.
# STAGING_ENV=WATCH_FLOW=…,WATCH_MODEL=…   # extra KEY=VALUE, comma-separated; values A-Z a-z 0-9 _ . / : @ + - only;
#                               # may not set the computed names (packs, private titles, limits, WATCH_BENCH_TOKEN)
# RELEASE=1                     # deploy-staging without a bench token: the revision meant for promote
# PROMOTE_WITH_BENCH_TOKEN=1    # promote a revision that carries the bench token anyway (refused otherwise)
# MIN_INSTANCES=1
# MAX_INSTANCES=2
# WATCH_ASK_PER_MINUTE=6
# WATCH_ASK_PER_DAY_PER_IP=80
# WATCH_ASK_PER_DAY_TOTAL=1500

# bench
# BENCH_URL=                    # default: the URL of the TAG revision
# BENCH_FLOW=                   # context | tools: X-Watch-Flow per request (needs the bench token); run id suffix
# BENCH_ONLY=                   # case-id prefixes, comma-separated (e.g. new:,ed-)
# BENCH_COMPARE=                # earlier run id to put side by side with this run
# BENCH_WORKERS=1
# BENCH_LLM=1                   # 0: rule gate only (no Gemini judge)
# BENCH_RUN_ID=                 # default: <MMDD-HHMM UTC>-<TAG>; reusing an id resumes that run
# BENCH_LABEL=                  # free text in the scorecard header (default: the staging image and env)
# BENCH_GENERATE=               # N: run N generated cases per film (bench/gen_cases.py) instead of the hand-written
#                               #   ones, as its own run (id suffix -gen); cases under .cache/bench/generated/<run>
# BENCH_TITLES=public           # with BENCH_GENERATE: public | private | all (private preview titles via the bench token)
# BENCH_SEED=1                  # with BENCH_GENERATE: same seed + same packs = same cases
# BENCH_SHOW_PRIVATE=           # 1: job logs show question / answer / rule text of private preview titles' cases too

# job (tools/ops/run.sh job → tools/ops/job.sh)
# JOB=                          # inspect-packs | publish-public-packs | publish-private-title | bench-show | logs
#                               # (several, comma-separated, run in order)
# PRIVATE_TITLE_SHAS=           # asset sha256 of each private preview title, comma-separated (opaque ids only)
# PRIVATE_PREFIX=               # bucket path of the private titles file (<PRIVATE_PREFIX>/titles.json); deploy-staging
#                               # sets WATCH_PRIVATE_TITLES to it on the new revision (unset: what production serves;
#                               # none: no private titles)
# PRIVATE_ACCESS_SHA256=        # sha256 (hex) of each access code, comma-separated; never the codes themselves
# PREVIEW_REBUILD=              # publish-private-title: 1 = encode and upload the preview again
# BENCH_SHOW_RUN=               # bench-show: run id under .cache/bench/runs (default: the latest graded run)
# BENCH_SHOW_CASES=             # bench-show: case ids, comma-separated (default: every failing case)
# BENCH_REJUDGE_RUNS=           # rejudge: stored run ids, comma-separated (a+b merges a re-run); BENCH_COMPARE puts
#                               # an earlier run side by side; grades results.jsonl again, never asks the service
# LOGS_SINCE=2h                 # logs: how far back (30m, 2h, 1d)
# LOGS_FILTER=                  # logs: extra Cloud Logging filter, ANDed (e.g. textPayload:"guard")
